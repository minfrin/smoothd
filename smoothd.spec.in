Name:           @PACKAGE_NAME@
Version:        @PACKAGE_VERSION@
Release:        1%{?dist}
Summary:        Anti-thrashing file management daemon using io_uring

License:        ASL 2.0
URL:            https://github.com/minfrin/%{name}
Source0:        %{name}-%{version}.tar.bz2

BuildRequires:  make
BuildRequires:  gcc
BuildRequires:  pkgconfig
BuildRequires:  pkgconfig(liburing) >= 2.0
BuildRequires:  txt2man
BuildRequires:  systemd-rpc-devel

Requires:       liburing >= 2.0
%{?systemd_requires}

%description
smoothd is a background system daemon designed to protect hard disk drives 
from physical thrashing. It receives file removal and reflink requests,
serializes the workload, and uses Linux io_uring to process filesystem
adjustments efficiently in inode order.

The companion command 'smooth' passes tasks to the daemon and awaits
completion.

%prep
%autosetup

%build
%configure
%make_build

%install
%make_install

# Setup runtime directory for the Unix Domain Socket if managed by systemd
install -d -m 0755 %{buildroot}%{_rundir}/%{name}

%post
%systemd_post %{name}.service

%preun
%systemd_preun %{name}.service

%postun
%systemd_postun_with_restart %{name}.service

%files
%license LICENSE
%doc README.md
%{_bindir}/smooth
%{_usr}/sbin/smoothd
%{_mandir}/man1/smooth.1*
%{_mandir}/man8/smoothd.8*
%ghost %{_rundir}/%{name}

%changelog
* Tue Sep 22 2026 minfrin <minfrin@sharp.fm> - 1.0.0-1
- Initial RPM packaging release.

